# Copy to .env (next to docker-compose.yml) and fill in the required values.
# Required
JWT_SECRET=generate-a-random-string-of-at-least-32-characters

# Database
MONGO_DB_NAME=devcommunity

# Ports published on the host
BACKEND_PORT=5000
FRONTEND_PORT=3000

# Browser-facing URLs. NEXT_PUBLIC_API_URL is baked into the frontend at build time,
# so rebuild the frontend image after changing it: docker compose build frontend
NEXT_PUBLIC_API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=

# Auth
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
# Plain-http local Docker needs COOKIE_SECURE=false and COOKIE_SAMESITE=lax.
# Behind HTTPS on separate sites use COOKIE_SECURE=true and COOKIE_SAMESITE=none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
TRUST_PROXY=
SWAGGER_ENABLED=

# Optional admin seeding (docker compose exec backend npm run seed:admin)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=YourOwnStrongPassword123

# Optional integrations (uploads need Cloudinary, summaries need Groq; otherwise the mock summarizer is used)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
SUMMARIZER_TIMEOUT_MS=10000